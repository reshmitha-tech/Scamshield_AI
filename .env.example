# ScamShield AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── AI Model Provider ─────────────────────────────────────────────────────────
# Options: mock | local | snapdragon
# "mock" uses rule-based logic — no model required.
# "local" requires MODEL_PATH to point to a quantized GGUF/ONNX model file.
# "snapdragon" requires MODEL_PATH + onnxruntime-qnn + Snapdragon hardware.
MODEL_PROVIDER=mock

# Path to local model file (required for local/snapdragon providers)
MODEL_PATH=

# Set to true to attempt QNN Execution Provider on Snapdragon NPU.
# Only effective when MODEL_PROVIDER=snapdragon.
# Do NOT set to true unless running on verified Snapdragon hardware.
USE_QNN=false

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./scamshield.db

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Upload limits ─────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
